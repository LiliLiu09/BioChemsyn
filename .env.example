ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Supabase project URL. Use the base URL only, without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe Supabase publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for CMS writes, quote storage, JSON migration, and Storage uploads.
# Keep this out of GitHub and deployment logs.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Postgres connection string for future direct SQL tools.
DATABASE_URL=

# Quote notification recipient. Owner/sales inbox for new inquiry emails.
SALES_EMAIL=support@biochemsyn.com

# Resend email delivery. Verify biochemsyn.com or the sender address in Resend before production use.
RESEND_API_KEY=
MAIL_FROM="凯森斯生物 KASONS <support@biochemsyn.com>"

# Legacy SMTP placeholders. Not used by the current Resend implementation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
